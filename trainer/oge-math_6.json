{"n":6,"passages":[],"tasks":[{"id":"oge_shk_100325","t":"Найдите значение выражения (5/6 + 7/15) · 9.","a":["11,7"],"k":"num","s":"сборник И.В. Ященко","sol":["1) $\\frac{5}{6}+\\frac{7}{15}=1{,}3$.","2) $(\\frac{5}{6}+\\frac{7}{15})\\cdot9=11{,}7$.","Ответ: 11,7."],"p":"o6_frac"},{"id":"oge_shk_104276","t":"Найдите значение выражения 6,4 + 7 · (-3,3).","a":["-16,7"],"k":"num","s":"сборник И.В. Ященко","sol":["1) $7\\cdot(-3{,}3)=-23{,}1$.","2) $6{,}4+7\\cdot(-3{,}3)=-16{,}7$.","Ответ: -16,7."],"p":"o6_dec"},{"id":"oge_shk_104285","t":"Найдите значение выражения (6,8 - 4,7)/1,4.","a":["1,5"],"k":"num","s":"сборник И.В. Ященко","sol":["1) $6{,}8-4{,}7=2{,}1$.","2) $(6{,}8-4{,}7):1{,}4=1{,}5$.","Ответ: 1,5."],"p":"o6_dec"},{"id":"oge_shk_104343","t":"Найдите значение выражения (11/35 - 9/14) · 21.","a":["-6,9"],"k":"num","s":"сборник И.В. Ященко","sol":["1) $\\frac{11}{35}-\\frac{9}{14}=-\\frac{23}{70}$.","2) $(\\frac{11}{35}-\\frac{9}{14})\\cdot21=-6{,}9$.","Ответ: -6,9."],"p":"o6_frac"},{"id":"oge_shk_104344","t":"Найдите значение выражения 1,8/(2,5 · 2,4).","a":["0,3"],"k":"num","s":"сборник И.В. Ященко","sol":["1) $2{,}5\\cdot2{,}4=6$.","2) $1{,}8:(2{,}5\\cdot2{,}4)=0{,}3$.","Ответ: 0,3."],"p":"o6_dec"},{"id":"oge_shk_104345","t":"Найдите значение выражения (5,6 · 0,9)/2,4.","a":["2,1"],"k":"num","s":"сборник И.В. Ященко","sol":["1) $5{,}6\\cdot0{,}9=5{,}04$.","2) $5{,}6\\cdot0{,}9:2{,}4=2{,}1$.","Ответ: 2,1."],"p":"o6_dec"},{"id":"oge_shk_104346","t":"Найдите значение выражения 5/36 + 14/45.\nПредставьте полученный результат в виде несократимой обыкновенной дроби. В ответ запишите числитель этой дроби.","a":["9"],"k":"num","s":"сборник И.В. Ященко","sol":["Вычисляем: $\\frac{5}{36}+\\frac{14}{45}=0{,}45$.","Несократимая дробь $0{,}45$, её числитель — $9$.","Ответ: 9."],"p":"o6_frac"},{"id":"oge_shk_104347","t":"Найдите значение выражения 0,8 · (-10)⁴ + 5 · (-10)³ - 76.","a":["2924"],"k":"num","s":"сборник И.В. Ященко","sol":["1) $(-10)^{4}=10000$.","2) $0{,}8\\cdot(-10)^{4}=8000$.","3) $(-10)^{3}=-1000$.","4) $5\\cdot(-10)^{3}=-5000$.","5) $0{,}8\\cdot(-10)^{4}+5\\cdot(-10)^{3}=3000$.","Ответ: 2924."],"p":"o6_dec"},{"id":"oge_shk_104348","t":"Найдите значение выражения 0,4 · (-10)³ - 7 · (-10)² + 64.","a":["-1036"],"k":"num","s":"сборник И.В. Ященко","sol":["1) $(-10)^{3}=-1000$.","2) $0{,}4\\cdot(-10)^{3}=-400$.","3) $(-10)^{2}=100$.","4) $7\\cdot(-10)^{2}=700$.","5) $0{,}4\\cdot(-10)^{3}-7\\cdot(-10)^{2}=-1100$.","Ответ: -1036."],"p":"o6_dec"},{"id":"oge_shk_104349","t":"Найдите значение выражения 4,2/(3 - 2/3).","a":["1,8"],"k":"num","s":"сборник И.В. Ященко","sol":["1) $3-\\frac{2}{3}=\\frac{7}{3}$.","2) $4{,}2:(3-\\frac{2}{3})=1{,}8$.","Ответ: 1,8."],"p":"o6_frac"},{"id":"oge_shk_104350","t":"Найдите значение выражения 4,4/(1/6 - 2).","a":["-2,4"],"k":"num","s":"сборник И.В. Ященко","sol":["1) $\\frac{1}{6}-2=-\\frac{11}{6}$.","2) $4{,}4:(\\frac{1}{6}-2)=-2{,}4$.","Ответ: -2,4."],"p":"o6_frac"},{"id":"oge_shk_104351","t":"Найдите значение выражения 5/12 + 4/15 + 1/6.","a":["0,85"],"k":"num","s":"сборник И.В. Ященко","sol":["1) $\\frac{5}{12}+\\frac{4}{15}=\\frac{41}{60}$.","2) $\\frac{5}{12}+\\frac{4}{15}+\\frac{1}{6}=0{,}85$.","Ответ: 0,85."],"p":"o6_frac"},{"id":"oge_shk_104352","t":"Найдите значение выражения 4/35 - 9/14 + 5/28.","a":["-0,35"],"k":"num","s":"сборник И.В. Ященко","sol":["1) $\\frac{4}{35}-\\frac{9}{14}=-\\frac{37}{70}$.","2) $\\frac{4}{35}-\\frac{9}{14}+\\frac{5}{28}=-0{,}35$.","Ответ: -0,35."],"p":"o6_frac"},{"id":"oge_shk_104353","t":"Найдите значение выражения 7,6 - 8 · (-5,2).","a":["49,2"],"k":"num","s":"сборник И.В. Ященко","sol":["1) $8\\cdot(-5{,}2)=-41{,}6$.","2) $7{,}6-8\\cdot(-5{,}2)=49{,}2$.","Ответ: 49,2."],"p":"o6_dec"},{"id":"oge_shk_104354","t":"Найдите значение выражения 13/30 + 23/45.\nПредставьте полученный результат в виде дроби со знаменателем 36. В ответ запишите числитель этой дроби.","a":["34"],"k":"num","s":"сборник И.В. Ященко","sol":["Вычисляем: $\\frac{13}{30}+\\frac{23}{45}=\\frac{17}{18}$.","Числитель дроби со знаменателем: $\\frac{17}{18}\\cdot36=34$.","Ответ: 34."],"p":"o6_frac"},{"id":"oge_shk_104355","t":"Найдите значение выражения 7/18 - 4/45.\nПредставьте полученный результат в виде дроби со знаменателем 40. В ответ запишите числитель этой дроби.","a":["12"],"k":"num","s":"сборник И.В. Ященко","sol":["Вычисляем: $\\frac{7}{18}-\\frac{4}{45}=0{,}3$.","Числитель дроби со знаменателем: $0{,}3\\cdot40=12$.","Ответ: 12."],"p":"o6_frac"},{"id":"oge_shk_104356","t":"Найдите значение выражения 12,6/(1,7 + 2,8).","a":["2,8"],"k":"num","s":"сборник И.В. Ященко","sol":["1) $1{,}7+2{,}8=4{,}5$.","2) $12{,}6:(1{,}7+2{,}8)=2{,}8$.","Ответ: 2,8."],"p":"o6_dec"},{"id":"oge_shk_104357","t":"Найдите значение выражения 4 7/45 + 3 17/18.","a":["8,1"],"k":"num","s":"сборник И.В. Ященко","sol":["Смешанные числа переводим в неправильные дроби: $4\\frac{7}{45}=\\frac{187}{45}$, $3\\frac{17}{18}=\\frac{71}{18}$.","Вычисляем: $\\frac{187}{45}+\\frac{71}{18}=8{,}1$.","Ответ: 8,1."],"p":"o6_frac"},{"id":"oge_shk_104358","t":"Найдите значение выражения 2 5/6 - 5 8/15.","a":["-2,7"],"k":"num","s":"сборник И.В. Ященко","sol":["Смешанные числа переводим в неправильные дроби: $2\\frac{5}{6}=\\frac{17}{6}$, $5\\frac{8}{15}=\\frac{83}{15}$.","Вычисляем: $\\frac{17}{6}-\\frac{83}{15}=-2{,}7$.","Ответ: -2,7."],"p":"o6_frac"},{"id":"oge_shk_104359","t":"Найдите значение выражения 45 + 0,6 · (-10)².","a":["105"],"k":"num","s":"сборник И.В. Ященко","sol":["1) $(-10)^{2}=100$.","2) $0{,}6\\cdot(-10)^{2}=60$.","3) $45+0{,}6\\cdot(-10)^{2}=105$.","Ответ: 105."],"p":"o6_dec"},{"id":"oge_shk_104360","t":"Найдите значение выражения 1 2/21 - 8/35.\nПредставьте полученный результат в виде несократимой обыкновенной дроби. В ответ запишите числитель этой дроби.","a":["13"],"k":"num","s":"сборник И.В. Ященко","sol":["Смешанные числа переводим в неправильные дроби: $1\\frac{2}{21}=\\frac{23}{21}$.","Вычисляем: $\\frac{23}{21}-\\frac{8}{35}=\\frac{13}{15}$.","Несократимая дробь $\\frac{13}{15}$, её числитель — $13$.","Ответ: 13."],"p":"o6_frac"},{"id":"oge_shk_104361","t":"Найдите значение выражения 1 7/45 - 11/60.\nПредставьте полученный результат в виде несократимой обыкновенной дроби. В ответ запишите числитель этой дроби.","a":["35"],"k":"num","s":"сборник И.В. Ященко","sol":["Смешанные числа переводим в неправильные дроби: $1\\frac{7}{45}=\\frac{52}{45}$.","Вычисляем: $\\frac{52}{45}-\\frac{11}{60}=\\frac{35}{36}$.","Несократимая дробь $\\frac{35}{36}$, её числитель — $35$.","Ответ: 35."],"p":"o6_frac"},{"id":"oge_shk_104362","t":"Найдите значение выражения 2/(1/24 + 1/56).","a":["33,6"],"k":"num","s":"сборник И.В. Ященко","sol":["1) $\\frac{1}{24}+\\frac{1}{56}=\\frac{5}{84}$.","2) $2:(\\frac{1}{24}+\\frac{1}{56})=33{,}6$.","Ответ: 33,6."],"p":"o6_frac"},{"id":"oge_shk_104363","t":"Найдите значение выражения 3/(1/35 - 1/60).","a":["252"],"k":"num","s":"сборник И.В. Ященко","sol":["1) $\\frac{1}{35}-\\frac{1}{60}=\\frac{1}{84}$.","2) $3:(\\frac{1}{35}-\\frac{1}{60})=252$.","Ответ: 252."],"p":"o6_frac"},{"id":"oge_shk_104364","t":"Найдите значение выражения 7/18 + (4/15)².","a":["0,46"],"k":"num","s":"сборник И.В. Ященко","sol":["1) $(\\frac{4}{15})^{2}=\\frac{16}{225}$.","2) $\\frac{7}{18}+(\\frac{4}{15})^{2}=0{,}46$.","Ответ: 0,46."],"p":"o6_frac"},{"id":"oge_shk_104365","t":"Найдите значение выражения (4/15)² - 13/36.","a":["-0,29"],"k":"num","s":"сборник И.В. Ященко","sol":["1) $(\\frac{4}{15})^{2}=\\frac{16}{225}$.","2) $(\\frac{4}{15})^{2}-\\frac{13}{36}=-0{,}29$.","Ответ: -0,29."],"p":"o6_frac"},{"id":"oge_shk_104366","t":"Найдите значение выражения 1,2 + 12 : (-4,8).","a":["-1,3"],"k":"num","s":"сборник И.В. Ященко","sol":["1) $12:(-4{,}8)=-2{,}5$.","2) $1{,}2+12:(-4{,}8)=-1{,}3$.","Ответ: -1,3."],"p":"o6_dec"},{"id":"oge_shk_104367","t":"Найдите значение выражения 4,5 - 36 : (-7,5).","a":["9,3"],"k":"num","s":"сборник И.В. Ященко","sol":["1) $36:(-7{,}5)=-4{,}8$.","2) $4{,}5-36:(-7{,}5)=9{,}3$.","Ответ: 9,3."],"p":"o6_dec"},