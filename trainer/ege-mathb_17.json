{"n":17,"passages":[],"tasks":[{"id":"base_shk_200713","t":"Найдите корень уравнения 2^(9-x)=8.","a":["6"],"k":"num","s":"Банк ФИПИ и демоверсии","sol":["$8 = 2^3$, приравниваем показатели: $9 - x = 3$.","$x = 6$.","Ответ: 6."],"p":"b17_exp"},{"id":"base_shk_71365","t":"Найдите корень уравнения log₁₉(37 - 4x) = log₁₉9.","a":["7"],"k":"num","s":"сборник И.В. Ященко","sol":["Основания одинаковые: $37 - 4x = 9$.","$4x = 28$, $x = 7$.","Ответ: 7."],"p":"b17_log"},{"id":"base_shk_73053","t":"Найдите корень уравнения log₁₃ (4x + 35) = log₁₃ 3.","a":["-8"],"k":"num","s":"сборник И.В. Ященко","sol":["Основания одинаковые: $4x + 35 = 3$.","$4x = -32$, $x = -8$.","Ответ: -8."],"p":"b17_log"},{"id":"base_shk_73054","t":"Найдите корень уравнения (1/5)^(3x + 4) : (1/5)^(-5x - 2) = 1/125.","a":["-0,375"],"k":"num","s":"сборник И.В. Ященко","sol":["При делении показатели вычитаются: $(3x + 4) - (-5x - 2) = 8x + 6$; $\\dfrac1{125} = \\left(\\dfrac15\\right)^3$.","$8x + 6 = 3$, $x = -0{,}375$.","Ответ: -0,375."],"p":"b17_exp"},{"id":"base_shk_73055","t":"Найдите корень уравнения lg (x - 1) + lg 6 = lg 18.","a":["4"],"k":"num","s":"сборник И.В. Ященко","sol":["$\\lg (6(x - 1)) = \\lg 18$, значит $6(x - 1) = 18$.","$x - 1 = 3$, $x = 4$.","Ответ: 4."],"p":"b17_log"},{"id":"base_shk_73056","t":"Найдите корень уравнения 3^(1 - 2x) = 81.","a":["-1,5"],"k":"num","s":"сборник И.В. Ященко","sol":["$81 = 3^4$: $1 - 2x = 4$.","$x = -1{,}5$.","Ответ: -1,5."],"p":"b17_exp"},{"id":"base_shk_73057","t":"Найдите корень уравнения log₅ (2x + 3) - log₅ 2 = 1.","a":["3,5"],"k":"num","s":"сборник И.В. Ященко","sol":["$\\log_5 \\dfrac{2x + 3}{2} = 1$, значит $\\dfrac{2x + 3}{2} = 5$.","$2x + 3 = 10$, $x = 3{,}5$.","Ответ: 3,5."],"p":"b17_log"},{"id":"base_shk_73058","t":"Найдите корень уравнения 3^(2 - 5x) = (1/27)^(x - 4).","a":["-5"],"k":"num","s":"сборник И.В. Ященко","sol":["$\\left(\\dfrac1{27}\\right)^{x - 4} = 3^{-3(x - 4)}$: $2 - 5x = -3x + 12$.","$-2x = 10$, $x = -5$.","Ответ: -5."],"p":"b17_exp"},{"id":"base_shk_73059","t":"Найдите корень уравнения log₅ (2x - 7) = 2.","a":["16"],"k":"num","s":"сборник И.В. Ященко","sol":["По определению: $2x - 7 = 5^2 = 25$.","$2x = 32$, $x = 16$.","Ответ: 16."],"p":"b17_log"},{"id":"base_shk_73060","t":"Найдите корень уравнения 4^(x - 6) = 64.","a":["9"],"k":"num","s":"сборник И.В. Ященко","sol":["$64 = 4^3$: $x - 6 = 3$.","$x = 9$.","Ответ: 9."],"p":"b17_exp"},{"id":"base_shk_73061","t":"Найдите корень уравнения log₇ (2x + 3) = 1.","a":["2"],"k":"num","s":"сборник И.В. Ященко","sol":["По определению: $2x + 3 = 7^1 = 7$.","$x = 2$.","Ответ: 2."],"p":"b17_log"},{"id":"base_shk_73062","t":"Найдите корень уравнения 2^(9 - x) = 8.","a":["6"],"k":"num","s":"сборник И.В. Ященко","sol":["$8 = 2^3$: $9 - x = 3$.","$x = 6$.","Ответ: 6."],"p":"b17_exp"},{"id":"base_shk_73063","t":"Найдите корень уравнения 4^(5x - 1) = 4^(4x + 1).","a":["2"],"k":"num","s":"сборник И.В. Ященко","sol":["Основания одинаковые: $5x - 1 = 4x + 1$.","$x = 2$.","Ответ: 2."],"p":"b17_exp"},{"id":"base_shk_73064","t":"Найдите корень уравнения log₂ (4x - 20) = 3.","a":["7"],"k":"num","s":"сборник И.В. Ященко","sol":["По определению: $4x - 20 = 2^3 = 8$.","$4x = 28$, $x = 7$.","Ответ: 7."],"p":"b17_log"},{"id":"base_shk_73065","t":"Найдите корень уравнения (1/3)^(x - 9) = 1/9.","a":["11"],"k":"num","s":"сборник И.В. Ященко","sol":["$\\dfrac19 = \\left(\\dfrac13\\right)^2$: $x - 9 = 2$.","$x = 11$.","Ответ: 11."],"p":"b17_exp"},{"id":"base_shk_73066","t":"Найдите корень уравнения 3^(x - 11) = 1/9.","a":["9"],"k":"num","s":"сборник И.В. Ященко","sol":["$\\dfrac19 = 3^{-2}$: $x - 11 = -2$.","$x = 9$.","Ответ: 9."],"p":"b17_exp"},{"id":"base_shk_73067","t":"Найдите корень уравнения (1/4)^(3 - x) = 64.","a":["6"],"k":"num","s":"сборник И.В. Ященко","sol":["$\\left(\\dfrac14\\right)^{3 - x} = 4^{x - 3}$, $64 = 4^3$: $x - 3 = 3$.","$x = 6$.","Ответ: 6."],"p":"b17_exp"},{"id":"base_shk_73068","t":"Найдите корень уравнения log₁₁ (7x - 12) = log₁₁ 23.","a":["5"],"k":"num","s":"сборник И.В. Ященко","sol":["Основания одинаковые: $7x - 12 = 23$.","$7x = 35$, $x = 5$.","Ответ: 5."],"p":"b17_log"},{"id":"base_shk_73069","t":"Найдите корень уравнения log₅ (2x - 6) - log₅ 2 = log₅ 3.","a":["6"],"k":"num","s":"сборник И.В. Ященко","sol":["$\\log_5 \\dfrac{2x - 6}{2} = \\log_5 3$: $x - 3 = 3$.","$x = 6$.","Ответ: 6."],"p":"b17_log"},{"id":"base_shk_73070","t":"Найдите корень уравнения 3^(2 - x) = 81.","a":["-2"],"k":"num","s":"сборник И.В. Ященко","sol":["$81 = 3^4$: $2 - x = 4$.","$x = -2$.","Ответ: -2."],"p":"b17_exp"},{"id":"base_shk_73111","t":"Решите уравнение 1/(√(x)) = 1/9.","a":["81"],"k":"num","s":"сборник И.В. Ященко","sol":["$\\sqrt x = 9$ (перевернули обе дроби).","$x = 81$.","Ответ: 81."],"p":"b17_alg"},{"id":"base_shk_74558","t":"Найдите корень уравнения 13^(2x + 3) : 13^(-4x - 11) = 169.","a":["-2"],"k":"num","s":"сборник И.В. Ященко","sol":["При делении показатели вычитаются: $(2x + 3) - (-4x - 11) = 6x + 14$; $169 = 13^2$.","$6x + 14 = 2$, $x = -2$.","Ответ: -2."],"p":"b17_exp"},{"id":"base_shk_75397","t":"Решите уравнение x² - 9x = -20.\nЕсли уравнение имеет больше одного корня, в ответе укажите больший из них.","a":["5"],"k":"num","s":"сборник И.В. Ященко","sol":["$x^2 - 9x + 20 = 0$, корни 4 и 5 (сумма 9, произведение 20).","Больший корень — 5.","Ответ: 5."],"p":"b17_alg"},{"id":"base_shk_78199","t":"Решите уравнение x²+7x=-12.\nЕсли уравнение имеет более одного корня, в ответе укажите больший из них.","a":["-3"],"k":"num","s":"сборник И.В. Ященко","sol":["$x^2 + 7x + 12 = 0$, корни $-3$ и $-4$ (сумма $-7$, произведение 12).","Больший корень — $-3$.","Ответ: -3."],"p":"b17_alg"},{"id":"base_gen_17_1","t":"Решите уравнение x² + x = 2.\nЕсли уравнение имеет более одного корня, в ответе укажите меньший из них.","a":["-2"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Перенесём всё влево: $x^2 + x - 2 = 0$.","По теореме Виета (или через $D = 9$): $x_1 = -2$, $x_2 = 1$.","Меньший корень — $-2$.","Ответ: -2."],"p":"b17_alg"},{"id":"base_gen_17_2","t":"Найдите корень уравнения (1/2)^(x + 9) = 1/2.","a":["-8"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["$\\dfrac1{2} = \\left(\\dfrac1{2}\\right)^{1}$, приравняем показатели: $x - (-9) = 1$.","$x = -8$.","Ответ: -8."],"p":"b17_exp"},{"id":"base_gen_17_3","t":"Найдите корень уравнения log₇(−3x − 25) = log₇ 35.","a":["-20"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Основания одинаковые — приравниваем выражения: $-3x + (-25) = 35$.","$x = -20$.","Ответ: -20."],"p":"b17_log"},{"id":"base_gen_17_4","t":"Найдите корень уравнения 48/(x + 1) = 8.","a":["5"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["$x + 1 = \\dfrac{48}{8} = 6$.","$x = 5$.","Ответ: 5."],"p":"b17_alg"},{"id":"base_gen_17_5","t":"Найдите корень уравнения (1/5)^(x − 5) = 1/5.","a":["6"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["$\\dfrac1{5} = \\left(\\dfrac1{5}\\right)^{1}$, приравняем показатели: $x - (5) = 1$.","$x = 6$.","Ответ: 6."],"p":"b17_exp"},{"id":"base_gen_17_6","t":"Найдите корень уравнения log₂(7x + 20) = log₂ 6.","a":["-2"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Основания одинаковые — приравниваем выражения: $7x + (20) = 6$.","$x = -2$.","Ответ: -2."],"p":"b17_log"},{"id":"base_gen_17_7","t":"Найдите корень уравнения √(6x − 123) = 3.","a":["22"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Возведём обе части в квадрат: $6x - 123 = 9$.","$6x = 132$, $x = 22$.","Ответ: 22."],"p":"b17_alg"},{"id":"base_gen_17_8","t":"Найдите корень уравнения 3^(2x + 9) : 3^(−6x − 10) = 3.","a":["-2,25"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["При делении показатели вычитаются: $(2x + 9) - (-6x + -10) = 1$ (так как $3 = 3^{1}$).","$8x = -18$, $x = -2{,}25$.","Ответ: -2,25."],"p":"b17_exp"},{"id":"base_gen_17_9","t":"Найдите корень уравнения log₁₃(−2x + 40) = 2.","a":["-64,5"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["По определению логарифма: $-2x + (40) = 13^{2} = 169$.","$x = -64{,}5$ (под логарифмом получается 169 > 0).","Ответ: -64,5."],"p":"b17_log"},{"id":"base_gen_17_10","t":"Найдите корень уравнения −16/(x − 5) = 4.","a":["1"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["$x - 5 = \\dfrac{-16}{4} = -4$.","$x = 1$.","Ответ: 1."],"p":"b17_alg"},{"id":"base_gen_17_11","t":"Найдите корень уравнения (1/4)^(x + 3) = 1/64.","a":["0"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["$\\dfrac1{64} = \\left(\\dfrac1{4}\\right)^{3}$, приравняем показатели: $x - (-3) = 3$.","$x = 0$.","Ответ: 0."],"p":"b17_exp"},{"id":"base_gen_17_12","t":"Найдите корень уравнения log₁₃(x + 8) + log₁₃ 5 = log₁₃ 30.","a":["-2"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Сумма логарифмов — логарифм произведения: $5(x + 8) = 30$.","$x + 8 = 6$, $x = -2$.","Ответ: -2."],"p":"b17_log"},{"id":"base_gen_17_13","t":"Решите уравнение x² + 6x = 27.\nЕсли уравнение имеет более одного корня, в ответе укажите больший из них.","a":["3"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Перенесём всё влево: $x^2 + 6x - 27 = 0$.","По теореме Виета (или через $D = 144$): $x_1 = -9$, $x_2 = 3$.","Больший корень — $3$.","Ответ: 3."],"p":"b17_alg"},{"id":"base_gen_17_14","t":"Найдите корень уравнения 4^(−2x − 3) = 64.","a":["-3"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["$64 = 4^{3}$, приравняем показатели: $-2x + (-3) = 3$.","$x = -3$.","Ответ: -3."],"p":"b17_exp"},{"id":"base_gen_17_15","t":"Найдите корень уравнения log₂(−6x + 10) = 2.","a":["1"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["По определению логарифма: $-6x + (10) = 2^{2} = 4$.","$x = 1$ (под логарифмом получается 4 > 0).","Ответ: 1."],"p":"b17_log"},{"id":"base_gen_17_16","t":"Найдите корень уравнения √(5x − 419) = 9.","a":["100"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Возведём обе части в квадрат: $5x - 419 = 81$.","$5x = 500$, $x = 100$.","Ответ: 100."],"p":"b17_alg"},{"id":"base_gen_17_17","t":"Найдите корень уравнения 7^(2x − 3) : 7^(−4x − 2) = 49.","a":["0,5"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["При делении показатели вычитаются: $(2x + -3) - (-4x + -2) = 2$ (так как $49 = 7^{2}$).","$6x = 3$, $x = 0{,}5$.","Ответ: 0,5."],"p":"b17_exp"},{"id":"base_gen_17_18","t":"Найдите корень уравнения log₁₁(x − 4) + log₁₁ 4 = log₁₁ 8.","a":["6"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Сумма логарифмов — логарифм произведения: $4(x - 4) = 8$.","$x - 4 = 2$, $x = 6$.","Ответ: 6."],"p":"b17_log"},{"id":"base_gen_17_19","t":"Найдите корень уравнения −36/(x − 6) = 4.","a":["-3"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["$x - 6 = \\dfrac{-36}{4} = -9$.","$x = -3$.","Ответ: -3."],"p":"b17_alg"},{"id":"base_gen_17_20","t":"Найдите корень уравнения (1/7)^(x + 8) = 1/343.","a":["-5"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["$\\dfrac1{343} = \\left(\\dfrac1{7}\\right)^{3}$, приравняем показатели: $x - (-8) = 3$.","$x = -5$.","Ответ: -5."],"p":"b17_exp"},{"id":"base_gen_17_21","t":"Найдите корень уравнения log₇(4x − 16) = 1.","a":["5,75"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["По определению логарифма: $4x + (-16) = 7^{1} = 7$.","$x = 5{,}75$ (под логарифмом получается 7 > 0).","Ответ: 5,75."],"p":"b17_log"},{"id":"base_gen_17_22","t":"Найдите корень уравнения √(7x − 465) = 9.","a":["78"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Возведём обе части в квадрат: $7x - 465 = 81$.","$7x = 546$, $x = 78$.","Ответ: 78."],"p":"b17_alg"},{"id":"base_gen_17_23","t":"Найдите корень уравнения 5^(3x + 5) = 25.","a":["-1"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["$25 = 5^{2}$, приравняем показатели: $3x + (5) = 2$.","$x = -1$.","Ответ: -1."],"p":"b17_exp"},{"id":"base_gen_17_24","t":"Найдите корень уравнения log₃(x + 8) + log₃ 3 = log₃ 12.","a":["-4"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Сумма логарифмов — логарифм произведения: $3(x + 8) = 12$.","$x + 8 = 4$, $x = -4$.","Ответ: -4."],"p":"b17_log"},{"id":"base_gen_17_25","t":"Решите уравнение x² − 3x = 40.\nЕсли уравнение имеет более одного корня, в ответе укажите меньший из них.","a":["-5"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Перенесём всё влево: $x^2 - 3x - 40 = 0$.","По теореме Виета (или через $D = 169$): $x_1 = -5$, $x_2 = 8$.","Меньший корень — $-5$.","Ответ: -5."],"p":"b17_alg"},{"id":"base_gen_17_26","t":"Найдите корень уравнения (1/7)^(x − 5) = 1/49.","a":["7"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["$\\dfrac1{49} = \\left(\\dfrac1{7}\\right)^{2}$, приравняем показатели: $x - (5) = 2$.","$x = 7$.","Ответ: 7."],"p":"b17_exp"},{"id":"base_gen_17_27","t":"Найдите корень уравнения log₃(−2x + 23) = log₃ 23.","a":["0"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Основания одинаковые — приравниваем выражения: $-2x + (23) = 23$.","$x = 0$.","Ответ: 0."],"p":"b17_log"},{"id":"base_gen_17_28","t":"Найдите корень уравнения 16/(x − 4) = 2.","a":["12"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["$x - 4 = \\dfrac{16}{2} = 8$.","$x = 12$.","Ответ: 12."],"p":"b17_alg"},{"id":"base_gen_17_29","t":"Найдите корень уравнения 5^(1 − x) = 125.","a":["-2"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["$125 = 5^{3}$, приравняем показатели: $-1x + (1) = 3$.","$x = -2$.","Ответ: -2."],"p":"b17_exp"},{"id":"base_gen_17_30","t":"Найдите корень уравнения log₇(−6x + 19) = 1.","a":["2"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["По определению логарифма: $-6x + (19) = 7^{1} = 7$.","$x = 2$ (под логарифмом получается 7 > 0).","Ответ: 2."],"p":"b17_log"},{"id":"base_gen_17_31","t":"Найдите корень уравнения 8x − 18 = 7x + 16.","a":["34"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Иксы влево, числа вправо: $8x - 7x = 16 - (-18)$.","$1x = 34$, $x = 34$.","Ответ: 34."],"p":"b17_alg"},{"id":"base_gen_17_32","t":"Найдите корень уравнения 2^(4x − 7) : 2^(−x − 9) = 2.","a":["-0,2"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["При делении показатели вычитаются: $(4x + -7) - (-1x + -9) = 1$ (так как