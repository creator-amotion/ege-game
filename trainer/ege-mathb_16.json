{"n":16,"passages":[],"tasks":[{"id":"base_gen_16_1","t":"Найдите значение выражения (5³)³ : 5⁷.","a":["25"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Основания одинаковые: при умножении показатели складываем, при делении вычитаем, степень степени — перемножаем.","Получаем $5^{2} = 25$.","Ответ: 25."],"p":"b16_pow"},{"id":"base_gen_16_2","t":"Найдите значение выражения 6√7 · 3√7.","a":["126"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["$6 \\cdot 3 = 18$, $\\sqrt{7} \\cdot \\sqrt{7} = 7$.","$18 \\cdot 7 = 126$.","Ответ: 126."],"p":"b16_root"},{"id":"base_gen_16_3","t":"Найдите значение выражения 7^(log₇ 3).","a":["3"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Основное логарифмическое тождество: $a^{\\log_a b} = b$.","$7^{\\log_{7} 3} = 3$.","Ответ: 3."],"p":"b16_log"},{"id":"base_gen_16_4","t":"Найдите значение выражения (a − 2)² − a(4 + a) при a = 0,1.","a":["3,2"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Раскроем скобки: $a^2 - 4a + 4 - 4a - a^2 = 4 - 8a$.","При $a = 0{,}1$: $4 - 8 \\cdot (0{,}1) = 3{,}2$.","Ответ: 3,2."],"p":"b16_alg"},{"id":"base_gen_16_5","t":"Найдите значение выражения 7√3 · tg(π/3).","a":["21"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["$\\operatorname{tg}\\dfrac{\\pi}{3} = \\sqrt3$.","$7\\sqrt3 \\cdot \\sqrt3 = 7 \\cdot 3 = 21$.","Ответ: 21."],"p":"b16_trig"},{"id":"base_gen_16_6","t":"Найдите значение выражения (3²)³ : 3³.","a":["27"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Основания одинаковые: при умножении показатели складываем, при делении вычитаем, степень степени — перемножаем.","Получаем $3^{3} = 27$.","Ответ: 27."],"p":"b16_pow"},{"id":"base_gen_16_7","t":"Найдите значение выражения 5√5 · 6√5.","a":["150"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["$5 \\cdot 6 = 30$, $\\sqrt{5} \\cdot \\sqrt{5} = 5$.","$30 \\cdot 5 = 150$.","Ответ: 150."],"p":"b16_root"},{"id":"base_gen_16_8","t":"Найдите значение выражения lg 0,0001 + log₃ 9.","a":["-2"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["$\\lg 0{,}0001 = -4$, $\\log_{3} 9 = 2$.","$-4 + 2 = -2$.","Ответ: -2."],"p":"b16_log"},{"id":"base_gen_16_9","t":"Найдите значение выражения (2a + 3b)² − 4a² − 9b² при a = 1,2, b = 1/3.","a":["4,8"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["$(2a + 3b)^2 = 4a^2 + 12ab + 9b^2$, после вычитания остаётся $12ab$.","$12 \\cdot 1{,}2 \\cdot (\\frac{1}{3}) = 4{,}8$.","Ответ: 4,8."],"p":"b16_alg"},{"id":"base_gen_16_10","t":"Найдите значение выражения 19 sin² α + 19 cos² α.","a":["19"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Вынесем 19: $19(\\sin^2\\alpha + \\cos^2\\alpha)$.","$\\sin^2\\alpha + \\cos^2\\alpha = 1$, значит выражение равно $19$.","Ответ: 19."],"p":"b16_trig"},{"id":"base_gen_16_11","t":"Найдите значение выражения 5⁷ · 20⁷ : 100⁶.","a":["100"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Одинаковые показатели: $5^{7} \\cdot 20^{7} = 100^{7}$.","$100^{7} : 100^{6} = 100^{1} = 100$.","Ответ: 100."],"p":"b16_pow"},{"id":"base_gen_16_12","t":"Найдите значение выражения √162 : √2.","a":["9"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["$\\sqrt{162} : \\sqrt{2} = \\sqrt{162 : 2} = \\sqrt{81}$.","$= 9$.","Ответ: 9."],"p":"b16_root"},{"id":"base_gen_16_13","t":"Найдите значение выражения log₃ 21 − log₃ 7.","a":["1"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Разность логарифмов — логарифм частного: $\\log_{3} \\dfrac{21}{7} = \\log_{3} 3$.","$3 = 3^{1}$.","Ответ: 1."],"p":"b16_log"},{"id":"base_gen_16_14","t":"Найдите значение выражения (2a + 3b)² − 4a² − 9b² при a = −8, b = 4.","a":["-384"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["$(2a + 3b)^2 = 4a^2 + 12ab + 9b^2$, после вычитания остаётся $12ab$.","$12 \\cdot -8 \\cdot (4) = -384$.","Ответ: -384."],"p":"b16_alg"},{"id":"base_gen_16_15","t":"Найдите значение выражения 36 cos(2π/3).","a":["-18"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["$\\dfrac{2\\pi}{3} = 120^\\circ$, $\\cos 120^\\circ = -\\dfrac12$.","$36 \\cdot \\left(-\\dfrac12\\right) = -18$.","Ответ: -18."],"p":"b16_trig"},{"id":"base_gen_16_16","t":"Найдите значение выражения 2⁴ · 2⁻¹.","a":["8"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Основания одинаковые: при умножении показатели складываем, при делении вычитаем, степень степени — перемножаем.","Получаем $2^{3} = 8$.","Ответ: 8."],"p":"b16_pow"},{"id":"base_gen_16_17","t":"Найдите значение выражения 9√10 · 9√10.","a":["810"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["$9 \\cdot 9 = 81$, $\\sqrt{10} \\cdot \\sqrt{10} = 10$.","$81 \\cdot 10 = 810$.","Ответ: 810."],"p":"b16_root"},{"id":"base_gen_16_18","t":"Найдите значение выражения lg 0,0001 + log₅ 25.","a":["-2"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["$\\lg 0{,}0001 = -4$, $\\log_{5} 25 = 2$.","$-4 + 2 = -2$.","Ответ: -2."],"p":"b16_log"},{"id":"base_gen_16_19","t":"Найдите значение выражения (2a + 3b)² − 4a² − 9b² при a = 1, b = −2/3.","a":["-8"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["$(2a + 3b)^2 = 4a^2 + 12ab + 9b^2$, после вычитания остаётся $12ab$.","$12 \\cdot 1 \\cdot (-\\frac{2}{3}) = -8$.","Ответ: -8."],"p":"b16_alg"},{"id":"base_gen_16_20","t":"Найдите значение выражения 36 sin(π/6) · cos(π/3).","a":["9"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["$\\sin\\dfrac{\\pi}{6} = \\dfrac12$, $\\cos\\dfrac{\\pi}{3} = \\dfrac12$.","$36 \\cdot \\dfrac12 \\cdot \\dfrac12 = 9$.","Ответ: 9."],"p":"b16_trig"},{"id":"base_gen_16_21","t":"Найдите значение выражения 2¹⁷ : 2¹⁶.","a":["2"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Основания одинаковые: при умножении показатели складываем, при делении вычитаем, степень степени — перемножаем.","Получаем $2^{1} = 2$.","Ответ: 2."],"p":"b16_pow"},{"id":"base_gen_16_22","t":"Найдите значение выражения 5√11 · 5√11.","a":["275"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["$5 \\cdot 5 = 25$, $\\sqrt{11} \\cdot \\sqrt{11} = 11$.","$25 \\cdot 11 = 275$.","Ответ: 275."],"p":"b16_root"},{"id":"base_gen_16_23","t":"Найдите значение выражения 2 log₂ 2 − log₂ 1.","a":["2"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["$2\\log_{2} 2 = \\log_{2} 4$.","$\\log_{2} \\dfrac{4}{1} = \\log_{2} 4$, и $4 = 2^{2}$.","Ответ: 2."],"p":"b16_log"},{"id":"base_gen_16_24","t":"Найдите значение выражения (x² − 4)/(x − 2) при x = 1,9.","a":["3,9"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Разность квадратов: $x^2 - 4 = (x - 2)(x + 2)$, после сокращения остаётся $x + 2$.","$1{,}9 + 2 = 3{,}9$.","Ответ: 3,9."],"p":"b16_alg"},{"id":"base_gen_16_25","t":"Найдите значение выражения 11² · 11⁻¹.","a":["11"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Основания одинаковые: при умножении показатели складываем, при делении вычитаем, степень степени — перемножаем.","Получаем $11^{1} = 11$.","Ответ: 11."],"p":"b16_pow"},{"id":"base_gen_16_26","t":"Найдите значение выражения 9√10 · 3√10.","a":["270"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["$9 \\cdot 3 = 27$, $\\sqrt{10} \\cdot \\sqrt{10} = 10$.","$27 \\cdot 10 = 270$.","Ответ: 270."],"p":"b16_root"},{"id":"base_gen_16_27","t":"Найдите значение выражения 2 log₂ 3 − log₂ 1,125.","a":["3"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["$2\\log_{2} 3 = \\log_{2} 9$.","$\\log_{2} \\dfrac{9}{1{,}125} = \\log_{2} 8$, и $8 = 2^{3}$.","Ответ: 3."],"p":"b16_log"},{"id":"base_gen_16_28","t":"Найдите значение выражения (2a + 3b)² − 4a² − 9b² при a = −0,75, b = −1/6.","a":["1,5"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["$(2a + 3b)^2 = 4a^2 + 12ab + 9b^2$, после вычитания остаётся $12ab$.","$12 \\cdot -0{,}75 \\cdot (-\\frac{1}{6}) = 1{,}5$.","Ответ: 1,5."],"p":"b16_alg"},{"id":"base_gen_16_29","t":"Найдите значение выражения 12√3 · tg(π/3).","a":["36"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["$\\operatorname{tg}\\dfrac{\\pi}{3} = \\sqrt3$.","$12\\sqrt3 \\cdot \\sqrt3 = 12 \\cdot 3 = 36$.","Ответ: 36."],"p":"b16_trig"},{"id":"base_gen_16_30","t":"Найдите значение выражения 2³ · 5³ : 10².","a":["10"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Одинаковые показатели: $2^{3} \\cdot 5^{3} = 10^{3}$.","$10^{3} : 10^{2} = 10^{1} = 10$.","Ответ: 10."],"p":"b16_pow"},{"id":"base_gen_16_31","t":"Найдите значение выражения 4√7 · 6√7.","a":["168"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["$4 \\cdot 6 = 24$, $\\sqrt{7} \\cdot \\sqrt{7} = 7$.","$24 \\cdot 7 = 168$.","Ответ: 168."],"p":"b16_root"},{"id":"base_gen_16_32","t":"Найдите значение выражения 3^(log₃ 4).","a":["4"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Основное логарифмическое тождество: $a^{\\log_a b} = b$.","$3^{\\log_{3} 4} = 4$.","Ответ: 4."],"p":"b16_log"},{"id":"base_gen_16_33","t":"Найдите значение выражения (x² − 25)/(x − 5) при x = −4.","a":["1"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Разность квадратов: $x^2 - 25 = (x - 5)(x + 5)$, после сокращения остаётся $x + 5$.","$-4 + 5 = 1$.","Ответ: 1."],"p":"b16_alg"},{"id":"base_gen_16_34","t":"Найдите значение выражения −20 sin² α − 20 cos² α.","a":["-20"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Вынесем −20: −$20(\\sin^2\\alpha + \\cos^2\\alpha)$.","$\\sin^2\\alpha + \\cos^2\\alpha = 1$, значит выражение равно $-20$.","Ответ: -20."],"p":"b16_trig"},{"id":"base_gen_16_35","t":"Найдите значение выражения 13¹⁷ : 13¹⁶.","a":["13"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Основания одинаковые: при умножении показатели складываем, при делении вычитаем, степень степени — перемножаем.","Получаем $13^{1} = 13$.","Ответ: 13."],"p":"b16_pow"},{"id":"base_gen_16_36","t":"Найдите значение выражения √(61² − 11²).","a":["60"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["$61^2 - 11^2 = (61 - 11)(61 + 11) = 50 \\cdot 72 = 3600$.","$\\sqrt{3600} = 60$.","Ответ: 60."],"p":"b16_root"},{"id":"base_gen_16_37","t":"Найдите значение выражения 2^(log₂ 5).","a":["5"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Основное логарифмическое тождество: $a^{\\log_a b} = b$.","$2^{\\log_{2} 5} = 5$.","Ответ: 5."],"p":"b16_log"},{"id":"base_gen_16_38","t":"Найдите значение выражения (2a + 3b)² − 4a² − 9b² при a = −7, b = −3.","a":["252"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["$(2a + 3b)^2 = 4a^2 + 12ab + 9b^2$, после вычитания остаётся $12ab$.","$12 \\cdot -7 \\cdot (-3) = 252$.","Ответ: 252."],"p":"b16_alg"},{"id":"base_gen_16_39","t":"Найдите значение выражения 9√3 · tg(π/3).","a":["27"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["$\\operatorname{tg}\\dfrac{\\pi}{3} = \\sqrt3$.","$9\\sqrt3 \\cdot \\sqrt3 = 9 \\cdot 3 = 27$.","Ответ: 27."],"p":"b16_trig"},{"id":"base_gen_16_40","t":"Найдите значение выражения 4³ · 25³ : 100².","a":["100"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Одинаковые показатели: $4^{3} \\cdot 25^{3} = 100^{3}$.","$100^{3} : 100^{2} = 100^{1} = 100$.","Ответ: 100."],"p":"b16_pow"}]}