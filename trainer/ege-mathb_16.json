{"n":16,"passages":[],"tasks":[{"id":"base_gen_16_1","t":"Найдите значение выражения (5³)³ : 5⁷.","a":["25"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Основания одинаковые: при умножении показатели складываем, при делении вычитаем, степень степени — перемножаем.","Получаем $5^{2} = 25$.","Ответ: 25."],"p":"b16_pow"},{"id":"base_gen_16_2","t":"Найдите значение выражения 6√7 · 3√7.","a":["126"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["$6 \\cdot 3 = 18$, $\\sqrt{7} \\cdot \\sqrt{7} = 7$.","$18 \\cdot 7 = 126$.","Ответ: 126."],"p":"b16_root"},{"id":"base_gen_16_3","t":"Найдите значение выражения 7^(log₇ 3).","a":["3"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Основное логарифмическое тождество: $a^{\\log_a b} = b$.","$7^{\\log_{7} 3} = 3$.","Ответ: 3."],"p":"b16_log"},{"id":"base_gen_16_4","t":"Найдите значение выражения (a − 2)² − a(4 + a) при a = 0,1.","a":["3,2"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Раскроем скобки: $a^2 - 4a + 4 - 4a - a^2 = 4 - 8a$.","При $a = 0{,}1$: $4 - 8 \\cdot (0{,}1) = 3{,}2$.","Ответ: 3,2."],"p":"b16_alg"},{"id":"base_gen_16_5","t":"Найдите значение выражения 7√3 · tg(π/3).","a":["21"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["$\\operatorname{tg}\\dfrac{\\pi}{3} = \\sqrt3$.","$7\\sqrt3 \\cdot \\sqrt3 = 7 \\cdot 3 = 21$.","Ответ: 21."],"p":"b16_trig"},{"id":"base_gen_16_6","t":"Найдите значение выражения (3²)³ : 3³.","a":["27"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Основания одинаковые: при умножении показатели складываем, при делении вычитаем, степень степени — перемножаем.","Получаем $3^{3} = 27$.","Ответ: 27."],"p":"b16_pow"},{"id":"base_gen_16_7","t":"Найдите значение выражения 5√5 · 6√5.","a":["150"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["$5 \\cdot 6 = 30$, $\\sqrt{5} \\cdot \\sqrt{5} = 5$.","$30 \\cdot 5 = 150$.","Ответ: 150."],"p":"b16_root"},{"id":"base_gen_16_8","t":"Найдите значение выражения lg 0,0001 + log₃ 9.","a":["-2"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["$\\lg 0{,}0001 = -4$, $\\log_{3} 9 = 2$.","$-4 + 2 = -2$.","Ответ: -2."],"p":"b16_log"},{"id":"base_gen_16_9","t":"Найдите значение выражения (2a + 3b)² − 4a² − 9b² при a = 1,2, b = 1/3.","a":["4,8"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["$(2a + 3b)^2 = 4a^2 + 12ab + 9b^2$, после вычитания остаётся $12ab$.","$12 \\cdot 1{,}2 \\cdot (\\frac{1}{3}) = 4{,}8$.","Ответ: 4,8."],"p":"b16_alg"},{"id":"base_gen_16_10","t":"Найдите значение выражения 19 sin² α + 19 cos² α.","a":["19"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Вынесем 19: $19(\\sin^2\\alpha + \\cos^2\\alpha)$.","$\\sin^2\\alpha + \\cos^2\\alpha = 1$, значит выражение равно $19$.","Ответ: 19."],"p":"b16_trig"},{"id":"base_gen_16_11","t":"Найдите значение выражения 5⁷ · 20⁷ : 100⁶.","a":["100"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Одинаковые показатели: $5^{7} \\cdot 20^{7} = 100^{7}$.","$100^{7} : 100^{6} = 100^{1} = 100$.","Ответ: 100."],"p":"b16_pow"},{"id":"base_gen_16_12","t":"Найдите значение выражения √162 : √2.","a":["9"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["$\\sqrt{162} : \\sqrt{2} = \\sqrt{162 : 2} = \\sqrt{81}$.","$= 9$.","Ответ: 9."],"p":"b16_root"},{"id":"base_gen_16_13","t":"Найдите значение выражения log₃ 21 − log₃ 7.","a":["1"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Разность логарифмов — логарифм частного: $\\log_{3} \\dfrac{21}{7} = \\log_{3} 3$.","$3 = 3^{1}$.","Ответ: 1."],"p":"b16_log"},{"id":"base_gen_16_14","t":"Найдите значение выражения (2a + 3b)² − 4a² − 9b² при a = −8, b = 4.","a":["-384"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["$(2a + 3b)^2 = 4a^2 + 12ab + 9b^2$, после вычитания остаётся $12ab$.","$12 \\cdot -8 \\cdot (4) = -384$.","Ответ: -384."],"p":"b16_alg"},{"id":"base_gen_16_15","t":"Найдите значение выражения 36 cos(2π/3).","a":["-18"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["$\\dfrac{2\\pi}{3} = 120^\\circ$, $\\cos 120^\\circ = -\\dfrac12$.","$36 \\cdot \\left(-\\dfrac12\\right) = -18$.","Ответ: -18."],"p":"b16_trig"},{"id":"base_gen_16_16","t":"Найдите значение выражения 2⁴ · 2⁻¹.","a":["8"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Основания одинаковые: при умножении показатели складываем, при делении вычитаем, степень степени — перемножаем.","Получаем $2^{3} = 8$.","Ответ: 8."],"p":"b16_pow"},{"id":"base_gen_16_17","t":"Найдите значение выражения 9√10 · 9√10.","a":["810"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["$9 \\cdot 9 = 81$, $\\sqrt{10} \\cdot \\sqrt{10} = 10$.","$81 \\cdot 10 = 810$.","Ответ: 810."],"p":"b16_root"},{"id":"base_gen_16_18","t":"Найдите значение выражения lg 0,0001 + log₅ 25.","a":["-2"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["$\\lg 0{,}0001 = -4$, $\\log_{5} 25 = 2$.","$-4 + 2 = -2$.","Ответ: -2."],"p":"b16_log"},{"id":"base_gen_16_19","t":"Найдите значение выражения (2a + 3b)² − 4a² − 9b² при a = 1, b = −2/3.","a":["-8"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["$(2a + 3b)^2 = 4a^2 + 12ab + 9b^2$, после вычитания остаётся $12ab$.","$12 \\cdot 1 \\cdot (-\\frac{2}{3}) = -8$.","Ответ: -8."],"p":"b16_alg"},{"id":"base_gen_16_20","t":"Найдите значение выражения 36 sin(π/6) · cos(π/3).","a":["9"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["$\\sin\\dfrac{\\pi}{6} = \\dfrac12$, $\\cos\\dfrac{\\pi}{3} = \\dfrac12$.","$36 \\cdot \\dfrac12 \\cdot \\dfrac12 = 9$.","Ответ: 9."],"p":"b16_trig"},{"id":"base_gen_16_21","t":"Найдите значение выражения 2¹⁷ : 2¹⁶.","a":["2"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Основания одинаковые: при умножении показатели складываем, при делении вычитаем, степень степени — перемножаем.","Получаем $2^{1} = 2$.","Ответ: 2."],"p":"b16_pow"},{"id":"base_gen_16_22","t":"Найдите значение выражения 5√11 · 5√11.","a":["275"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["$5 \\cdot 5 = 25$, $\\sqrt{11} \\cdot \\sqrt{11} = 11$.","$25 \\cdot 11 = 275$.","Ответ: 275."],"p":"b16_root"},{"id":"base_gen_16_23","t":"Найдите значение выражения 2 log₂ 2 − log₂ 1.","a":["2"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["$2\\log_{2} 2 = \\log_{2} 4$.","$\\log_{2} \\dfrac{4}{1} = \\log_{2} 4$, и $4 = 2^{2}$.","Ответ: 2."],"p":"b16_log"},{"id":"base_gen_16_24","t":"Найдите значение выражения (x² − 4)/(x − 2) при x = 1,9.","a":["3,9"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Разность квадратов: $x^2 - 4 = (x - 2)(x + 2)$, после сокращения остаётся $x + 2$.","$1{,}9 + 2 = 3{,}9$.","Ответ: 3,9."],"p":"b16_alg"},{"id":"base_gen_16_25","t":"Найдите значение выражения 11² · 11⁻¹.","a":["11"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Основания одинаковые: при умножении показатели складываем, при делении вычитаем, степень степени — перемножаем.","Получаем $11^{1} = 11$.","Ответ: 11."],"p":"b16_pow"},{"id":"base_gen_16_26","t":"Найдите значение выражения 9√10 · 3√10.","a":["270"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["$9 \\cdot 3 = 27$, $\\sqrt{10} \\cdot \\sqrt{10} = 10$.","$27 \\cdot 10 = 270$.","Ответ: 270."],"p":"b16_root"},{"id":"base_gen_16_27","t":"Найдите значение выражения 2 log₂ 3 − log₂ 1,125.","a":["3"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["$2\\log_{2} 3 = \\log_{2} 9$.","$\\log_{2} \\dfrac{9}{1{,}125} = \\log_{2} 8$, и $8 = 2^{3}$.","Ответ: 3."],"p":"b16_log"},{"id":"base_gen_16_28","t":"Найдите значение выражения (2a + 3b)² − 4a² − 9b² при a = −0,75, b = −1/6.","a":["1,5"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["$(2a + 3b)^2 = 4a^2 + 12ab + 9b^2$, после вычитания остаётся $12ab$.","$12 \\cdot -0{,}75 \\cdot (-\\frac{1}{6}) = 1{,}5$.","Ответ: 1,5."],"p":"b16_alg"},{"id":"base_gen_16_29","t":"Найдите значение выражения 12√3 · tg(π/3).","a":["36"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["$\\operatorname{tg}\\dfrac{\\pi}{3} = \\sqrt3$.","$12\\sqrt3 \\cdot \\sqrt3 = 12 \\cdot 3 = 36$.","Ответ: 36."],"p":"b16_trig"},{"id":"base_gen_16_30","t":"Найдите значение выражения 2³ · 5³ : 10².","a":["10"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Одинаковые показатели: $2^{3} \\cdot 5^{3} = 10^{3}$.","$10^{3} : 10^{2} = 10^{1} = 10$.","Ответ: 10."],"p":"b16_pow"},{"id":"base_gen_16_31","t":"Найдите значение выражения 4√7 · 6√7.","a":["168"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["$4 \\cdot 6 = 24$, $\\sqrt{7} \\cdot \\sqrt{7} = 7$.","$24 \\cdot 7 = 168$.","Ответ: 168."],"p":"b16_root"},{"id":"base_gen_16_32","t":"Найдите значение выражения 3^(log₃ 4).","a":["4"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Основное логарифмическое тождество: $a^{\\log_a b} = b$.","$3^{\\log_{3} 4} = 4$.","Ответ: 4."],"p":"b16_log"},{"id":"base_gen_16_33","t":"Найдите значение выражения (x² − 25)/(x − 5) при x = −4.","a":["1"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Разность квадратов: $x^2 - 25 = (x - 5)(x + 5)$, после сокращения остаётся $x + 5$.","$-4 + 5 = 1$.","Ответ: 1."],"p":"b16_alg"},{"id":"base_gen_16_34","t":"Найдите значение выражения −20 sin² α − 20 cos² α.","a":["-20"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Вынесем −20: −$20(\\sin^2\\alpha + \\cos^2\\alpha)$.","$\\sin^2\\alpha + \\cos^2\\alpha = 1$, значит выражение равно $-20$.","Ответ: -20."],"p":"b16_trig"},{"id":"base_gen_16_35","t":"Найдите значение выражения 13¹⁷ : 13¹⁶.","a":["13"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Основания одинаковые: при умножении показатели складываем, при делении вычитаем, степень степени — перемножаем.","Получаем $13^{1} = 13$.","Ответ: 13."],"p":"b16_pow"},{"id":"base_gen_16_36","t":"Найдите значение выражения √(61² − 11²).","a":["60"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["$61^2 - 11^2 = (61 - 11)(61 + 11) = 50 \\cdot 72 = 3600$.","$\\sqrt{3600} = 60$.","Ответ: 60."],"p":"b16_root"},{"id":"base_gen_16_37","t":"Найдите значение выражения 2^(log₂ 5).","a":["5"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Основное логарифмическое тождество: $a^{\\log_a b} = b$.","$2^{\\log_{2} 5} = 5$.","Ответ: 5."],"p":"b16_log"},{"id":"base_gen_16_38","t":"Найдите значение выражения (2a + 3b)² − 4a² − 9b² при a = −7, b = −3.","a":["252"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["$(2a + 3b)^2 = 4a^2 + 12ab + 9b^2$, после вычитания остаётся $12ab$.","$12 \\cdot -7 \\cdot (-3) = 252$.","Ответ: 252."],"p":"b16_alg"},{"id":"base_gen_16_39","t":"Найдите значение выражения 9√3 · tg(π/3).","a":["27"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["$\\operatorname{tg}\\dfrac{\\pi}{3} = \\sqrt3$.","$9\\sqrt3 \\cdot \\sqrt3 = 9 \\cdot 3 = 27$.","Ответ: 27."],"p":"b16_trig"},{"id":"base_gen_16_40","t":"Найдите значение выражения 4³ · 25³ : 100².","a":["100"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Одинаковые показатели: $4^{3} \\cdot 25^{3} = 100^{3}$.","$100^{3} : 100^{2} = 100^{1} = 100$.","Ответ: 100."],"p":"b16_pow"},{"id":"base_gen_16_41","t":"Найдите значение выражения √63 : √7.","a":["3"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["$\\sqrt{63} : \\sqrt{7} = \\sqrt{63 : 7} = \\sqrt{9}$.","$= 3$.","Ответ: 3."],"p":"b16_root"},{"id":"base_gen_16_42","t":"Найдите значение выражения lg 0,01 + log₇ 49.","a":["0"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["$\\lg 0{,}01 = -2$, $\\log_{7} 49 = 2$.","$-2 + 2 = 0$.","Ответ: 0."],"p":"b16_log"},{"id":"base_gen_16_43","t":"Найдите значение выражения (x² − 25)/(x − 5) при x = −2,3.","a":["2,7"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Разность квадратов: $x^2 - 25 = (x - 5)(x + 5)$, после сокращения остаётся $x + 5$.","$-2{,}3 + 5 = 2{,}7$.","Ответ: 2,7."],"p":"b16_alg"},{"id":"base_gen_16_44","t":"Найдите значение выражения 4 cos(2π/3).","a":["-2"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["$\\dfrac{2\\pi}{3} = 120^\\circ$, $\\cos 120^\\circ = -\\dfrac12$.","$4 \\cdot \\left(-\\dfrac12\\right) = -2$.","Ответ: -2."],"p":"b16_trig"},{"id":"base_gen_16_45","t":"Найдите значение выражения (6⁵)³ : 6¹⁴.","a":["6"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Основания одинаковые: при умножении показатели складываем, при делении вычитаем, степень степени — перемножаем.","Получаем $6^{1} = 6$.","Ответ: 6."],"p":"b16_pow"},{"id":"base_gen_16_46","t":"Найдите значение выражения √2,5 · √10.","a":["5"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["$\\sqrt{2{,}5} \\cdot \\sqrt{10} = \\sqrt{25}$.","$= 5$.","Ответ: 5."],"p":"b16_root"},{"id":"base_gen_16_47","t":"Найдите значение выражения 2 log₅ 4 − log₅ 0,64.","a":["2"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["$2\\log_{5} 4 = \\log_{5} 16$.","$\\log_{5} \\dfrac{16}{0{,}64} = \\log_{5} 25$, и $25 = 5^{2}$.","Ответ: 2."],"p":"b16_log"},{"id":"base_gen_16_48","t":"Найдите значение выражения (x² − 49)/(x − 7) при x = 1,2.","a":["8,2"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Разность квадратов: $x^2 - 49 = (x - 7)(x + 7)$, после сокращения остаётся $x + 7$.","$1{,}2 + 7 = 8{,}2$.","Ответ: 8,2."],"p":"b16_alg"},{"id":"base_gen_16_49","t":"Найдите значение выражения 3√3 · tg(π/3).","a":["9"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["$\\operatorname{tg}\\dfrac{\\pi}{3} = \\sqrt3$.","$3\\sqrt3 \\cdot \\sqrt3 = 3 \\cdot 3 = 9$.","Ответ: 9."],"p":"b16_trig"},{"id":"base_gen_16_50","t":"Найдите значение выражения (11²)⁴ : 11⁵.","a":["1331"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Основания одинаковые: при умножении показатели складываем, при делении вычитаем, степень степени — перемножаем.","Получаем $11^{3} = 1331$.","Ответ: 1331."],"p":"b16_pow"},{"id":"base_gen_16_51","t":"Найдите значение выражения √320 : √5.","a":["8"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["$\\sqrt{320} : \\sqrt{5} = \\sqrt{320 : 5} = \\sqrt{64}$.","$= 8$.","Ответ: 8."],"p":"b16_root"},{"id":"base_gen_16_52","t":"Найдите значение выражения log₇ 7 + log₇ 49.","a":["3"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Сумма логарифмов — логарифм произведения: $\\log_{7} (7 \\cdot 49) = \\log_{7} 343$.","$343 = 7^{3}$.","Ответ: 3."],"p":"b16_log"},{"id":"base_gen_16_53","t":"Найдите значение выражения (2a + 3b)² − 4a² − 9b² при a = −1,5, b = 4/9.","a":["-8"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["$(2a + 3b)^2 = 4a^2 + 12ab + 9b^2$, после вычитания остаётся $12ab$.","$12 \\cdot -1{,}5 \\cdot (\\frac{4}{9}) = -8$.","Ответ: -8."],"p":"b16_alg"},{"id":"base_gen_16_54","t":"Найдите значение выражения 34 cos(2π/3).","a":["-17"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["$\\dfrac{2\\pi}{3} = 120^\\circ$, $\\cos 120^\\circ = -\\dfrac12$.","$34 \\cdot \\left(-\\dfrac12\\right) = -17$.","Ответ: -17."],"p":"b16_trig"},{"id":"base_gen_16_55","t":"Найдите значение выражения 2⁹ · 50⁹ : 100⁷.","a":["10000"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Одинаковые показатели: $2^{9} \\cdot 50^{9} = 100^{9}$.","$100^{9} : 100^{7} = 100^{2} = 10000$.","Ответ: 10000."],"p":"b16_pow"},{"id":"base_gen_16_56","t":"Найдите значение выражения (√8 − √3)(√8 + √3).","a":["5"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Разность квадратов: $(\\sqrt a - \\sqrt b)(\\sqrt a + \\sqrt b) = a - b$.","$8 - 3 = 5$.","Ответ: 5."],"p":"b16_root"},{"id":"base_gen_16_57","t":"Найдите значение выражения 5^(log₅ 6).","a":["6"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Основное логарифмическое тождество: $a^{\\log_a b} = b$.","$5^{\\log_{5} 6} = 6$.","Ответ: 6."],"p":"b16_log"},{"id":"base_gen_16_58","t":"Найдите значение выражения (2a + 3b)² − 4a² − 9b² при a = −4,5, b = −4.","a":["216"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["$(2a + 3b)^2 = 4a^2 + 12ab + 9b^2$, после вычитания остаётся $12ab$.","$12 \\cdot -4{,}5 \\cdot (-4) = 216$.","Ответ: 216."],"p":"b16_alg"},{"id":"base_gen_16_59","t":"Найдите значение выражения 44 sin(π/6) · cos(π/3).","a":["11"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["$\\sin\\dfrac{\\pi}{6} = \\dfrac12$, $\\cos\\dfrac{\\pi}{3} = \\dfrac12$.","$44 \\cdot \\dfrac12 \\cdot \\dfrac12 = 11$.","Ответ: 11."],"p":"b16_trig"},{"id":"base_gen_16_60","t":"Найдите значение выражения 7⁵ : 7².","a":["343"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Основания одинаковые: при умножении показатели складываем, при делении вычитаем, степень степени — перемножаем.","Получаем $7^{3} = 343$.","Ответ: 343."],"p":"b16_pow"},{"id":"base_gen_16_61","t":"Найдите значение выражения √(17² − 8²).","a":["15"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["$17^2 - 8^2 = (17 - 8)(17 + 8) = 9 \\cdot 25 = 225$.","$\\sqrt{225} = 15$.","Ответ: 15."],"p":"b16_root"},{"id":"base_gen_16_62","t":"Найдите значение выражения 2 log₅ 6 − log₅ 7,2.","a":["1"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["$2\\log_{5} 6 = \\log_{5} 36$.","$\\log_{5} \\dfrac{36}{7{,}2} = \\log_{5} 5$, и $5 = 5^{1}$.","Ответ: 1."],"p":"b16_log"},{"id":"base_gen_16_63","t":"Найдите значение выражения (x² − 9)/(x − 3) при x = −1,5.","a":["1,5"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Разность квадратов: $x^2 - 9 = (x - 3)(x + 3)$, после сокращения остаётся $x + 3$.","$-1{,}5 + 3 = 1{,}5$.","Ответ: 1,5."],"p":"b16_alg"},{"id":"base_gen_16_64","t":"Найдите значение выражения 4√3 · tg(π/3).","a":["12"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["$\\operatorname{tg}\\dfrac{\\pi}{3} = \\sqrt3$.","$4\\sqrt3 \\cdot \\sqrt3 = 4 \\cdot 3 = 12$.","Ответ: 12."],"p":"b16_trig"},{"id":"base_gen_16_65","t":"Найдите значение выражения 2⁸ · 5⁸ : 10⁶.","a":["100"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Одинаковые показатели: $2^{8} \\cdot 5^{8} = 10^{8}$.","$10^{8} : 10^{6} = 10^{2} = 100$.","Ответ: 100."],"p":"b16_pow"},{"id":"base_gen_16_66","t":"Найдите значение выражения 8√2 · 4√2.","a":["64"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["$8 \\cdot 4 = 32$, $\\sqrt{2} \\cdot \\sqrt{2} = 2$.","$32 \\cdot 2 = 64$.","Ответ: 64."],"p":"b16_root"},{"id":"base_gen_16_67","t":"Найдите значение выражения log₃ 3 + log₃ 3.","a":["2"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Сумма логарифмов — логарифм произведения: $\\log_{3} (3 \\cdot 3) = \\log_{3} 9$.","$9 = 3^{2}$.","Ответ: 2."],"p":"b16_log"},{"id":"base_gen_16_68","t":"Найдите значение выражения (x² − 4)/(x − 2) при x = −1.","a":["1"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Разность квадратов: $x^2 - 4 = (x - 2)(x + 2)$, после сокращения остаётся $x + 2$.","$-1 + 2 = 1$.","Ответ: 1."],"p":"b16_alg"},{"id":"base_gen_16_69","t":"Найдите значение выражения 11 sin² α + 11 cos² α.","a":["11"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Вынесем 11: $11(\\sin^2\\alpha + \\cos^2\\alpha)$.","$\\sin^2\\alpha + \\cos^2\\alpha = 1$, значит выражение равно $11$.","Ответ: 11."],"p":"b16_trig"},{"id":"base_gen_16_70","t":"Найдите значение выражения 6⁵ : 6³.","a":["36"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Основания одинаковые: при умножении показатели складываем, при делении вычитаем, степень степени — перемножаем.","Получаем $6^{2} = 36$.","Ответ: 36."],"p":"b16_pow"},{"id":"base_gen_16_71","t":"Найдите значение выражения √(37² − 12²).","a":["35"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["$37^2 - 12^2 = (37 - 12)(37 + 12) = 25 \\cdot 49 = 1225$.","$\\sqrt{1225} = 35$.","Ответ: 35."],"p":"b16_root"},{"id":"base_gen_16_72","t":"Найдите значение выражения (x² − 16)/(x − 4) при x = −3,3.","a":["0,7"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Разность квадратов: $x^2 - 16 = (x - 4)(x + 4)$, после сокращения остаётся $x + 4$.","$-3{,}3 + 4 = 0{,}7$.","Ответ: 0,7."],"p":"b16_alg"},{"id":"base_gen_16_73","t":"Найдите значение выражения 6√3 · tg(π/3).","a":["18"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["$\\operatorname{tg}\\dfrac{\\pi}{3} = \\sqrt3$.","$6\\sqrt3 \\cdot \\sqrt3 = 6 \\cdot 3 = 18$.","Ответ: 18."],"p":"b16_trig"},{"id":"base_gen_16_74","t":"Найдите значение выражения (4²)³ : 4⁵.","a":["4"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Основания одинаковые: при умножении показатели складывае