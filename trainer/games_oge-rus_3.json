["Союз","Союзное слово"],"h":"«Как» — обстоятельство образа действия."},{"c":"sw","w":"Я понял, ЧТО он хотел мне сказать.","a":"Союзное слово","o":["Союз","Союзное слово"],"h":"«Что» — дополнение (хотел сказать что?)."},{"c":"sw","w":"Он сказал, ЧТОБЫ мы пришли вовремя.","a":"Союз","o":["Союз","Союзное слово"],"h":"Союз «чтобы» не является членом предложения."},{"c":"sw","w":"Не знаю, ГДЕ он живёт.","a":"Союзное слово","o":["Союз","Союзное слово"],"h":"«Где» — обстоятельство места."},{"c":"sw","w":"Я никогда не знал, ЧЕМ ты занимаешься в свободное время.","a":"Союзное слово","o":["Союз","Союзное слово"],"h":"«Чем» — дополнение (занимаешься чем?)."},{"c":"sw","w":"ХОТЯ Леонтьеву очень хотелось поехать в лесничество, он решил до осени никуда не выезжать.","a":"Союз","o":["Союз","Союзное слово"],"h":"Союз уступки «хотя»."},{"c":"sw","w":"КАК ни старался мальчик, ему не удавалось стать призёром.","a":"Союзное слово","o":["Союз","Союзное слово"],"h":"«Как ни» — обстоятельство образа действия."},{"c":"sw","w":"Сестра столько же старалась порадовать маму, СКОЛЬКО я пыталась наполнить её жизнь развлечениями.","a":"Союзное слово","o":["Союз","Союзное слово"],"h":"«Сколько» — обстоятельство меры и степени."},{"c":"sw","w":"Мне показалось, ЧТО редактор газеты очень хорошо понимал значение экспедиции.","a":"Союз","o":["Союз","Союзное слово"],"h":"Союз «что» не является членом предложения."},{"c":"sw","w":"Впереди, КУДА вела дорога, было немного посветлее.","a":"Союзное слово","o":["Союз","Союзное слово"],"h":"«Куда» — обстоятельство места (вела куда?)."},{"c":"sw","w":"Дед заботился о своей кошке настолько, НАСКОЛЬКО позволяла занятость на работе.","a":"Союзное слово","o":["Союзное слово","Союз"],"h":"«Насколько» — обстоятельство меры и степени."},{"c":"sw","w":"Воспитанный человек ведёт себя так, ЧТОБЫ не доставлять неприятностей другим людям.","a":"Союз","o":["Союз","Союзное слово"],"h":"Союз «чтобы» в придаточном образа действия."},{"c":"sw","w":"Скажи, ПОЧЕМУ ты опоздал.","a":"Союзное слово","o":["Союзное слово","Союз"],"h":"«Почему» — обстоятельство причины."},{"c":"sw","w":"Хочется верить, ЧТО читатели задумаются о значимости природы в жизни человека.","a":"Союз","o":["Союзное слово","Союз"],"h":"К союзу нельзя добавить «же», «именно»; союз не является членом предложения."},{"c":"sw","w":"Ольга пыталась запомнить всё, ЧТО увидела за время поездки к морю.","a":"Союзное слово","o":["Союзное слово","Союз"],"h":"«Что» — дополнение в придаточном (увидела что?), можно добавить «именно»."},{"c":"sw","w":"До появления людей на острове было так много птиц, ЧТО их крики заглушили бы удары волн о скалы.","a":"Союз","o":["Союзное слово","Союз"],"h":"Союз в придаточном меры и степени."},{"c":"sw","w":"Город благотворно влиял на молодого художника, ЧТО было заметно по его поведению.","a":"Союзное слово","o":["Союзное слово","Союз"],"h":"«Что» — подлежащее присоединительного придаточного, можно заменить на «и это»."},{"c":"sw","w":"ЧЕМ красивее котик, тем больше у него фанатов в социальных сетях.","a":"Союз","o":["Союзное слово","Союз"],"h":"Сравнительный союз, членом предложения не является."},{"c":"sw","w":"Он был уверен, БУДТО всё получится.","a":"Союз","o":["Союз","Союзное слово"],"h":"Союз «будто» не является членом предложения."}],"id":"g2"}]}