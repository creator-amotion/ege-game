{"n":14,"passages":[],"tasks":[{"id":"base_shk_200710","t":"Найдите значение выражения 5/4+7/6:2/3.","a":["3"],"k":"num","s":"Банк ФИПИ и демоверсии","sol":["Сначала деление: $\\dfrac76 : \\dfrac23 = \\dfrac76 \\cdot \\dfrac32 = \\dfrac74$.","$\\dfrac54 + \\dfrac74 = \\dfrac{12}{4} = 3$.","Ответ: 3."],"p":"b14_frac"},{"id":"base_shk_69682","t":"Найдите значение выражения\n(2 4/5 - 0,8) · 3 1/8.","a":["6,25"],"k":"num","s":"сборник И.В. Ященко","sol":["$2\\dfrac45 - 0{,}8 = 2{,}8 - 0{,}8 = 2$.","$2 \\cdot 3\\dfrac18 = 2 \\cdot \\dfrac{25}{8} = 6{,}25$.","Ответ: 6,25."],"p":"b14_mix"},{"id":"base_shk_69683","t":"Найдите значение выражения\n(2 4/9 - 2,8) : 4/45.","a":["-4"],"k":"num","s":"сборник И.В. Ященко","sol":["$2\\dfrac49 - 2{,}8 = \\dfrac{22}{9} - \\dfrac{14}{5} = \\dfrac{110 - 126}{45} = -\\dfrac{16}{45}$.","$-\\dfrac{16}{45} \\cdot \\dfrac{45}{4} = -4$.","Ответ: -4."],"p":"b14_mix"},{"id":"base_shk_69684","t":"Найдите значение выражения\n(2,7 + 5,8)/(6,8).","a":["1,25"],"k":"num","s":"сборник И.В. Ященко","sol":["$2{,}7 + 5{,}8 = 8{,}5$.","$8{,}5 : 6{,}8 = 1{,}25$.","Ответ: 1,25."],"p":"b14_dec"},{"id":"base_shk_69686","t":"Найдите значение выражения\n6 + 1/6 · 0,96.","a":["6,16"],"k":"num","s":"сборник И.В. Ященко","sol":["$\\dfrac16 \\cdot 0{,}96 = 0{,}16$.","$6 + 0{,}16 = 6{,}16$.","Ответ: 6,16."],"p":"b14_mix"},{"id":"base_shk_74555","t":"Найдите значение выражения (2,3 + 2,2) · 5,2.","a":["23,4"],"k":"num","s":"сборник И.В. Ященко","sol":["$2{,}3 + 2{,}2 = 4{,}5$.","$4{,}5 \\cdot 5{,}2 = 23{,}4$.","Ответ: 23,4."],"p":"b14_dec"},{"id":"base_shk_75394","t":"Найдите значение выражения 1/(1/10 - 1/15).","a":["30"],"k":"num","s":"сборник И.В. Ященко","sol":["$\\dfrac1{10} - \\dfrac1{15} = \\dfrac{3 - 2}{30} = \\dfrac1{30}$.","$1 : \\dfrac1{30} = 30$.","Ответ: 30."],"p":"b14_frac"},{"id":"base_shk_78196","t":"Найдите значение выражения (17/8-1/16):11/48","a":["9"],"k":"num","s":"сборник И.В. Ященко","sol":["$\\dfrac{17}{8} - \\dfrac1{16} = \\dfrac{34 - 1}{16} = \\dfrac{33}{16}$.","$\\dfrac{33}{16} \\cdot \\dfrac{48}{11} = 9$.","Ответ: 9."],"p":"b14_frac"},{"id":"base_gen_14_1","t":"Найдите значение выражения 4,5 · 8,2 − 5,3.","a":["31,6"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Умножение: $4{,}5 \\cdot 8{,}2 = 36{,}9$.","$36{,}9 - 5{,}3 = 31{,}6$.","Ответ: 31,6."],"p":"b14_dec"},{"id":"base_gen_14_2","t":"Найдите значение выражения 1/(1/13 − 1/23).","a":["29,9"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["$\\dfrac1{13} - \\dfrac1{23} = \\dfrac{10}{299}$.","$1 : \\dfrac{10}{299} = \\dfrac{299}{10} = 29{,}9$.","Ответ: 29,9."],"p":"b14_frac"},{"id":"base_gen_14_3","t":"Найдите значение выражения (23/10 − 1,4) · 19/9.","a":["1,9"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Скобки: $2{,}3 - 1{,}4 = 0{,}9$.","$0{,}9 \\cdot \\frac{19}{9} = 1{,}9$.","Ответ: 1,9."],"p":"b14_mix"},{"id":"base_gen_14_4","t":"Найдите значение выражения 6,8 · 2,8 − 9,9.","a":["9,14"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Умножение: $6{,}8 \\cdot 2{,}8 = 19{,}04$.","$19{,}04 - 9{,}9 = 9{,}14$.","Ответ: 9,14."],"p":"b14_dec"},{"id":"base_gen_14_5","t":"Найдите значение выражения 11/4 + 15/16 : 5/4.","a":["3,5"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Сначала деление: $0{,}9375 : 1{,}25 = 0{,}75$.","Потом сложение: $2{,}75 + 0{,}75 = 3{,}5$.","Ответ: 3,5."],"p":"b14_frac"},{"id":"base_gen_14_6","t":"Найдите значение выражения 3 + 1/8 · 3,6.","a":["3,45"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Умножение: $0{,}125 \\cdot 3{,}6 = 0{,}45$.","$3 + 0{,}45 = 3{,}45$.","Ответ: 3,45."],"p":"b14_mix"},{"id":"base_gen_14_7","t":"Найдите значение выражения (7,1 + 8,9) · 5,9.","a":["94,4"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Скобки: $7{,}1 + 8{,}9 = 16$.","$16 \\cdot 5{,}9 = 94{,}4$.","Ответ: 94,4."],"p":"b14_dec"},{"id":"base_gen_14_8","t":"Найдите значение выражения 1/(1/8 − 1/10).","a":["40"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["$\\dfrac1{8} - \\dfrac1{10} = \\dfrac{2}{80}$.","$1 : \\dfrac{2}{80} = \\dfrac{80}{2} = 40$.","Ответ: 40."],"p":"b14_frac"},{"id":"base_gen_14_9","t":"Найдите значение выражения 8 + 1/6 · 1,44.","a":["8,24"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Умножение: $\\frac{1}{6} \\cdot 1{,}44 = 0{,}24$.","$8 + 0{,}24 = 8{,}24$.","Ответ: 8,24."],"p":"b14_mix"},{"id":"base_gen_14_10","t":"Найдите значение выражения (7,1 + 1) : 0,3.","a":["27"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Скобки: $7{,}1 + 1 = 8{,}1$.","$8{,}1 : 0{,}3 = 27$.","Ответ: 27."],"p":"b14_dec"},{"id":"base_gen_14_11","t":"Найдите значение выражения 29/15 : 5/3 − 1/2.","a":["0,66"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Деление: $\\frac{29}{15} : \\frac{5}{3} = 1{,}16$.","$1{,}16 - 0{,}5 = 0{,}66$.","Ответ: 0,66."],"p":"b14_frac"},{"id":"base_gen_14_12","t":"Найдите значение выражения 8 + 1/4 · 0,2.","a":["8,05"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Умножение: $0{,}25 \\cdot 0{,}2 = 0{,}05$.","$8 + 0{,}05 = 8{,}05$.","Ответ: 8,05."],"p":"b14_mix"},{"id":"base_gen_14_13","t":"Найдите значение выражения 5,4 · 5 − 3,1.","a":["23,9"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Умножение: $5{,}4 \\cdot 5 = 27$.","$27 - 3{,}1 = 23{,}9$.","Ответ: 23,9."],"p":"b14_dec"},{"id":"base_gen_14_14","t":"Найдите значение выражения 5/2 + 11/4 : 5/2.","a":["3,6"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Сначала деление: $2{,}75 : 2{,}5 = 1{,}1$.","Потом сложение: $2{,}5 + 1{,}1 = 3{,}6$.","Ответ: 3,6."],"p":"b14_frac"},{"id":"base_gen_14_15","t":"Найдите значение выражения 8 + 1/3 · 2,13.","a":["8,71"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Умножение: $\\frac{1}{3} \\cdot 2{,}13 = 0{,}71$.","$8 + 0{,}71 = 8{,}71$.","Ответ: 8,71."],"p":"b14_mix"},{"id":"base_gen_14_16","t":"Найдите значение выражения 1,8 · 4,5 − 3,8.","a":["4,3"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Умножение: $1{,}8 \\cdot 4{,}5 = 8{,}1$.","$8{,}1 - 3{,}8 = 4{,}3$.","Ответ: 4,3."],"p":"b14_dec"},{"id":"base_gen_14_17","t":"Найдите значение выражения 7/4 + 1/5 : 1/2.","a":["2,15"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Сначала деление: $0{,}2 : 0{,}5 = 0{,}4$.","Потом сложение: $1{,}75 + 0{,}4 = 2{,}15$.","Ответ: 2,15."],"p":"b14_frac"},{"id":"base_gen_14_18","t":"Найдите значение выражения 2 + 1/4 · 0,2.","a":["2,05"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Умножение: $0{,}25 \\cdot 0{,}2 = 0{,}05$.","$2 + 0{,}05 = 2{,}05$.","Ответ: 2,05."],"p":"b14_mix"},{"id":"base_gen_14_19","t":"Найдите значение выражения 3,5 · 4,8 − 2,4.","a":["14,4"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["Умножение: $3{,}5 \\cdot 4{,}8 = 16{,}8$.","$16{,}8 - 2{,}4 = 14{,}4$.","Ответ: 14,4."],"p":"b14_dec"},{"id":"base_gen_14_20","t":"Найдите значение выражения 1/(1/24 − 1/36).","a":["72"],"k":"num","s":"Задание Аника по образцу ФИПИ","sol":["$\\dfrac1{24} - \\dfrac1{36} = \\dfrac{12}{864}$.","$1 : \\dfrac{12}{864} = \\dfrac{864}{12} = 72$.","Ответ: 72."],"p":"b14_frac"}]}